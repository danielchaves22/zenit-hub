PORT=3210
# Use 0.0.0.0 on Render; keep localhost for local development.
HUB_HOST=127.0.0.1
HUB_PUBLIC_URL=http://localhost:3210
# PostgreSQL dedicated database. On Render use its Internal Database URL,
# replacing only the database path with /zenit_hub. Never use the Cash database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zenit_hub
# Includes one reserved connection for the serial worker; keep small on shared instances.
HUB_DATABASE_POOL_MAX=5
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HUB_ENCRYPTION_KEY=
HUB_TIME_ZONE=America/Sao_Paulo
# Optional allowlist for a personal pilot, comma-separated WhatsApp sender IDs.
HUB_ALLOWED_SENDERS=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Proactive notifications remain unavailable until both configuration and Meta approval exist.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SUMMARY_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
# Same secret in the Cash backend. HTTPS required outside localhost.
CASH_API_URL=http://localhost:3000
CASH_HUB_SHARED_SECRET=
CASH_BINDING_PREFIX=VINCULAR ZENIT
CASH_CONNECT_URL=
OPENAI_API_KEY=
# Explicitly select a Responses API model in your account.
OPENAI_MODEL=
# Audio is transcribed once in Hub before choosing Cash, Day or Calendar.
WHATSAPP_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional; must be supported by the selected model. Use none for the economical Cash-compatible setup.
OPENAI_REASONING_EFFORT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAY_SUPABASE_URL=
# HTTPS origin serving /oauth/consent; same Site URL configured in Supabase Auth.
DAY_SITE_URL=
DAY_SUPABASE_PUBLISHABLE_KEY=
# Register a confidential OAuth client with client_secret_basic in Day's Supabase project.
DAY_CLIENT_ID=
DAY_CLIENT_SECRET=
